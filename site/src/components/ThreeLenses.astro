---
import './ThreeLenses.css';
import lenses from '../data/lenses.json';
import type { LensesData } from '../schemas/schemas';

const data = lenses as unknown as LensesData;
const baseline = data.positiveBaseline;
const lensList = data.lenses;
/**
 * ThreeLenses.astro — §2 The Three Lenses (table layout, user review 2026-10-29)
 * ------------------------------------------------------------------------------
 * Mirrors the paper's dimensions/examples table:
 *   [ Positive baseline card — shared credit-scoring explanation ]
 *   [ Coherence ] [ Validity ] [ Faithfulness ]  ← name + relationship
 *   [ per-lens rationale for why the baseline holds ]
 *   [ Negative examples — collapsible <details> per lens ]
 *
 * Security: data from typed JSON; auto-escaped rendering.
 */
---

<section id="three-lenses" class="section" aria-labelledby="lenses-title">
	<div class="container">
		<h2 id="lenses-title" data-reveal>The Three Lenses</h2>
		<p class="intro" data-reveal data-reveal-delay="1">
			An explanation can be judged against three reference points — each one a
			different way of being wrong. Usually you can only observe the explanation
			itself, so start there and work outward.
		</p>

		{/* ---- Positive baseline (shared running example, table row 1) ---- */}
		<div class="baseline" data-reveal data-reveal-delay="2">
			<h3 class="baseline-title">{baseline.title}</h3>
			<blockquote class="baseline-quote">
				&ldquo;{baseline.explanation}&rdquo;
			</blockquote>
			<p class="baseline-context">{baseline.context}</p>
		</div>

		{/* ---- Three lens columns: name + relationship + baseline rationale ---- */}
		<div class="lens-cards">
			{
				lensList.map((lens, i) => (
					<article class="lens-col" id={`lens-${lens.id}`} aria-labelledby={`lens-${lens.id}-title`} data-reveal data-reveal-delay={i}>
						<header class="lens-head">
							<span class="lens-number" aria-hidden="true">{lens.number}</span>
							<div>
								<h3 id={`lens-${lens.id}-title`}>{lens.name}</h3>
								<p class="relationship">{lens.relationship}</p>
							</div>
						</header>

						<p class="baseline-why">{lens.baselineWhy}</p>

						{/* First negative example shown by default in a red-bordered
						    box (user review 2026-11-02); the rest stay collapsible. */}
						{
							lens.facets[0] && (
								<div class="neg-example">
									<span class="neg-example-label">Negative example</span>
									<p><strong>{lens.facets[0].name}:</strong> {lens.facets[0].example}</p>
								</div>
							)
						}

						{/* Remaining negative examples — collapsible, same pattern as the old facets */}
						{
							lens.facets.length > 1 && (
								<details class="negatives">
									<summary>
										More negative examples
										
									</summary>
									<ul>
										{
											lens.facets.slice(1).map((ex) => (
												<li>
													<strong>{ex.name}:</strong> {ex.example}
												</li>
											))
										}
									</ul>
								</details>
							)
						}
					</article>
				))
			}
		</div>
	</div>
</section>


